{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/hacienda-ras-al-hekma", "destination": "/hacienda-ras-el-hekma", "permanent": true },
    { "source": "/about", "destination": "/about-us", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
