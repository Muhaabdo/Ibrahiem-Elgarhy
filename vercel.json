{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hacienda-ras-al-hekma",
      "destination": "/hacienda-ras-el-hekma",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/badya-palm-hills",
      "destination": "/badya",
      "permanent": true
    },
    {
      "source": "/palm-hills-projects",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/eastcairo",
      "destination": "/97-hills",
      "permanent": true
    },
    {
      "source": "/westcairo",
      "destination": "/badya",
      "permanent": true
    },
    {
      "source": "/palm-hills-ocotber-projects",
      "destination": "/badya",
      "permanent": true
    }
